POSTGRES_PASSWORD=replace-with-a-long-random-postgres-password
MINIO_ROOT_USER=replace-with-a-minio-admin-user
MINIO_ROOT_PASSWORD=replace-with-a-long-random-minio-password
JWT_SECRET_KEY=replace-with-at-least-32-random-characters
OPERATOR_USERNAME=admin
# Generate with: docker compose exec backend python -c "from app.core.security import get_password_hash; print(get_password_hash('your-password'))"
OPERATOR_PASSWORD_HASH=replace-with-a-bcrypt-hash

# Secure defaults. Enable the bypass only in isolated automated tests.
DEBUG=false
DEV_AUTH_BYPASS=false
NETWORK_DISCOVERY_ENABLED=false
MAIN_REAL_TELEMETRY_ONLY=true

# Dual-homed live telemetry. Keep the capture interface passive/no-IP in
# production; management values describe the authenticated device plane.
LIVE_TELEMETRY_ENABLED=true
# Keep lab captures inspection-only. For an approved production sensor, set
# profile=production and explicitly scope BOTH source IDs and protected CIDRs.
# Trusted graph analytics fail closed if either allowlist is missing or mismatched.
LIVE_TELEMETRY_PROFILE=lab
LIVE_TELEMETRY_APPROVED_CIDRS=
LIVE_TELEMETRY_APPROVED_SOURCE_IDS=
TELEMETRY_MGMT_IFACE=eth0
TELEMETRY_MGMT_VLAN=40
TELEMETRY_MGMT_CIDR=172.20.20.0/24
TELEMETRY_MGMT_GATEWAY=
TELEMETRY_CAPTURE_IFACE=eth1
TELEMETRY_CAPTURE_MODE=span_tap
FLOW_EXPORT_ENABLED=false
FLOW_EXPORT_LISTEN_ADDR=0.0.0.0
FLOW_EXPORT_LISTEN_PORT=2055
# Comma-separated exporter CIDRs; leave empty only while the listener is disabled.
FLOW_EXPORT_ALLOWED_CIDRS=

# Main UI calls the Next same-origin proxy, so LAN clients never use their
# own localhost. Leave the socket URL blank to use the page hostname on :8000.
NEXT_PUBLIC_API_URL=/api/v1
NEXT_PUBLIC_WS_URL=
